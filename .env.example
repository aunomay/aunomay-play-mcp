# Aunomay Play site (the MCP server reads its public catalog API at <site>/api/v1)
AUNOMAY_SITE_URL=https://play.aunomay.com
# Optional: shared secret sent as X-Aunomay-Mcp-Key (Cloudflare WAF skip rule)
# AUNOMAY_API_KEY=
# Optional: override the API base directly
# AUNOMAY_API_BASE=https://play.aunomay.com/api/v1
# Optional: public URL of this deployment (defaults to the Vercel production URL)
# NEXT_PUBLIC_BASE_URL=https://mcp.aunomay.com
# Token shown by OpenAI when verifying the domain for the ChatGPT app directory
# OPENAI_APPS_CHALLENGE=
